<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- BCP-47 tags stored by Pref; "system" clears the locale override. -->
    <string-array name="language_tags" translatable="false">
        <item>system</item>
        <item>zh-rCN</item>
        <item>en</item>
        <item>ko</item>
    </string-array>

    <!-- Self-names, so the labels stay clear regardless of the current locale. -->
    <string-array name="language_labels" translatable="false">
        <item>@string/settings_language_follow_system</item>
        <item>@string/settings_language_zh</item>
        <item>@string/settings_language_en</item>
        <item>@string/settings_language_ko</item>
    </string-array>
</resources>
