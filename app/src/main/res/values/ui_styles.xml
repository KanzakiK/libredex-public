<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LibreDeXSettingSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ui_panel_row_height</item>
        <item name="android:paddingStart">@dimen/ui_row_side_padding</item>
        <item name="android:paddingEnd">@dimen/ui_row_side_padding</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="LibreDeXSettingMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ui_panel_row_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/ui_row_side_padding</item>
        <item name="android:paddingEnd">@dimen/ui_row_side_padding</item>
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:drawablePadding">12dp</item>
    </style>

    <style name="LibreDeXDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">@dimen/ui_row_side_padding</item>
        <item name="android:layout_marginEnd">@dimen/ui_row_side_padding</item>
        <item name="android:background">@color/ui_divider</item>
    </style>

    <style name="LibreDeXLargeButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ui_panel_row_height</item>
        <item name="android:background">@drawable/bg_ui_large_button</item>
        <item name="android:elevation">@dimen/ui_shadow_small</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
