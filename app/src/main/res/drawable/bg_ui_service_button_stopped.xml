<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ui_surface_alt" />
            <corners android:radius="@dimen/ui_panel_radius" />
            <stroke android:width="1dp" android:color="@color/ui_border" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ui_surface" />
            <corners android:radius="@dimen/ui_panel_radius" />
            <stroke android:width="1dp" android:color="@color/ui_border" />
        </shape>
    </item>
</selector>
