<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:minWidth="340dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/debugLogTitle"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/log_debug"
            android:textColor="@color/ui_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/viewRecentHandshakeButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_ui_small_button"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/log_handshake"
            android:textColor="@color/ui_text_primary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/viewRecentControlInputButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ui_small_button"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/log_control_stats"
            android:textColor="@color/ui_text_primary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/debugSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_ui_debug_panel"
        android:fontFamily="monospace"
        android:lineSpacingExtra="1dp"
        android:maxLines="14"
        android:padding="10dp"
        android:textColor="@color/ui_text_primary"
        android:textSize="10.5sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/debugLogRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_ui_debug_panel"
        android:padding="8dp" />
</LinearLayout>
