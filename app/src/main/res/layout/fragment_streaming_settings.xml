<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/ui_page_padding"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <View style="@style/LibreDeXDivider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoConnectClientCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="自动连接 Moonlight 客户端" />

            <LinearLayout
                android:id="@+id/clientConnectionContainer"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_row_side_padding"
                android:paddingEnd="@dimen/ui_row_side_padding"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/clientSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/connectClientButton"
                    android:layout_width="@dimen/ui_small_button_width"
                    android:layout_height="@dimen/ui_small_button_height"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_ui_small_button"
                    android:elevation="@dimen/ui_shadow_small"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="连接"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="编码格式"
                android:textColor="@color/ui_text_primary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/encoderCodecSpinner"
                android:layout_width="match_parent"
                android:layout_height="42dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/encoderBitratePercentEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="码率比例"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="164dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="码率% 25-200 默认100"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <Spinner
                android:id="@+id/encoderBitrateModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/encoderComplexityEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="编码复杂度"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="148dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="复杂度 0-10 默认5"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/encoderIFrameIntervalEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="I 帧间隔"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="154dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="I帧(s) 1-10 默认3"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/encoderMaxFpsEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="最大编码 FPS"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="166dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="FPS 1-240 默认60"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/streamFecPercentEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="FEC 百分比"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="150dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="FEC% 0-50 默认0"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <Button
                    android:id="@+id/resetEncoderSettingsButton"
                    android:layout_width="92dp"
                    android:layout_height="@dimen/ui_small_button_height"
                    android:background="@drawable/bg_ui_small_button"
                    android:elevation="@dimen/ui_shadow_small"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="恢复默认"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/saveEncoderSettingsButton"
                    android:layout_width="92dp"
                    android:layout_height="@dimen/ui_small_button_height"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_ui_small_button"
                    android:elevation="@dimen/ui_shadow_small"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="保存"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderLowLatencyCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="低延迟编码" />

            <View style="@style/LibreDeXDivider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderDisableBFramesCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="禁用 B 帧" />

            <View style="@style/LibreDeXDivider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderRealtimePriorityCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="实时优先级" />

            <View style="@style/LibreDeXDivider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderDynamicFrameRateCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="动态帧率" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/disableUsbAudioCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="禁用 USB 外接屏音频输出" />
        </LinearLayout>

        <Button
            android:id="@+id/dexWallpaperButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ui_text_primary"
            android:text="更换 DeX 壁纸" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoStartBootCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:textColor="@color/ui_text_primary"
                android:text="开机自启 Sunshine 服务" />

            <View style="@style/LibreDeXDivider" />

            <Button
                android:id="@+id/moreSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/ui_text_primary"
                android:text="更多设置（屏幕管理 / 输入 / 权限）" />

            <View style="@style/LibreDeXDivider" />

            <Button
                android:id="@+id/viewLogsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/ui_text_primary"
                android:text="查看日志" />

            <Button
                android:id="@+id/exportLogsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/ui_text_primary"
                android:text="导出日志" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
