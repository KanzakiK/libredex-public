<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/ui_page_padding"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <View style="@style/LibreDeXDivider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoConnectClientCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="@string/connection_auto_connect_client" />

            <LinearLayout
                android:id="@+id/clientConnectionContainer"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_row_side_padding"
                android:paddingEnd="@dimen/ui_row_side_padding"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/clientSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/connectClientButton"
                    android:layout_width="@dimen/ui_small_button_width"
                    android:layout_height="@dimen/ui_small_button_height"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_ui_small_button"
                    android:elevation="@dimen/ui_shadow_small"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/nav_connect"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/encoder_format"
                android:textColor="@color/ui_text_primary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/encoderCodecSpinner"
                android:layout_width="match_parent"
                android:layout_height="42dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/encoderBitratePercentEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="@string/encoder_bitrate_ratio"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="164dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="@string/streaming_bitrate_range"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <Spinner
                android:id="@+id/encoderBitrateModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/encoderComplexityEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="@string/streaming_encoder_complexity"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="148dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="@string/streaming_complexity_range"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/encoderIFrameIntervalEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="@string/encoder_i_frame_interval"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="154dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="@string/streaming_iframe_range"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/encoderMaxFpsEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="@string/streaming_max_encoder_fps"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="166dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="@string/streaming_fps_range"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/streamFecPercentEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ui_input"
                    android:hint="@string/streaming_fec_percent"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="150dp"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:text="@string/streaming_fec_range"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <Button
                    android:id="@+id/resetEncoderSettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_small_button_height"
                    android:background="@drawable/bg_ui_small_button"
                    android:elevation="@dimen/ui_shadow_small"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/action_restore_default"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/saveEncoderSettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_small_button_height"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_ui_small_button"
                    android:elevation="@dimen/ui_shadow_small"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/action_save"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderLowLatencyCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="@string/encoder_low_latency" />

            <View style="@style/LibreDeXDivider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderDisableBFramesCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="@string/encoder_disable_b_frame" />

            <View style="@style/LibreDeXDivider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderRealtimePriorityCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="@string/encoder_realtime_priority" />

            <View style="@style/LibreDeXDivider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/encoderDynamicFrameRateCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="@string/encoder_dynamic_fps" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/disableUsbAudioCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:text="@string/audio_disable_usb_audio" />
        </LinearLayout>

        <Button
            android:id="@+id/dexWallpaperButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ui_text_primary"
            android:text="@string/dex_change_wallpaper" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoStartBootCheckbox"
                style="@style/LibreDeXSettingSwitch"
                android:textColor="@color/ui_text_primary"
                android:text="@string/streaming_autostart_sunshine" />

            <View style="@style/LibreDeXDivider" />

            <Button
                android:id="@+id/moreSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/ui_text_primary"
                android:text="@string/streaming_more_settings" />

            <View style="@style/LibreDeXDivider" />

            <Button
                android:id="@+id/viewLogsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/ui_text_primary"
                android:text="@string/connection_view_log" />

            <Button
                android:id="@+id/exportLogsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/ui_text_primary"
                android:text="@string/settings_export_log" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
