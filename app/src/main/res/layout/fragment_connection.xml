<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/transportTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/transportMoonlight"
                style="@style/LibreDeXTransportTab"
                android:text="Moonlight" />

            <Button
                android:id="@+id/transportDp"
                style="@style/LibreDeXTransportTab"
                android:text="DP / HDMI" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/firstUseCard"
            style="@style/LibreDeXCard"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/LibreDeXRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="首次使用？"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="完成授权与连接指引"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/openWizardButton"
                    style="@style/LibreDeXButtonSoft"
                    android:text="打开向导" />

                <ImageButton
                    android:id="@+id/hideFirstUseButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="隐藏"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="画面源"
                android:textColor="@color/ui_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="选择要投送的画面"
                android:textColor="@color/ui_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/sourceSegContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_libredex_seg_container"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/sourceDexButton"
                    style="@style/LibreDeXSegButton"
                    android:text="DeX 桌面" />
                <Button
                    android:id="@+id/sourceMirrorButton"
                    style="@style/LibreDeXSegButton"
                    android:text="纯镜像" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/quickActionsTitle"
            style="@style/LibreDeXSectionTitle"
            android:text="快捷操作" />

        <LinearLayout
            android:id="@+id/quickActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/quickTouchpad"
                style="@style/LibreDeXQuickAction"
                android:drawableTop="@drawable/ic_touchpad"
                android:drawableTint="@color/ui_accent"
                android:text="触控板" />
            <Button
                android:id="@+id/quickScreenOff"
                style="@style/LibreDeXQuickAction"
                android:drawableTop="@drawable/ic_screen_off"
                android:drawableTint="@color/ui_accent"
                android:text="息屏" />
            <Button
                android:id="@+id/quickWallpaper"
                style="@style/LibreDeXQuickAction"
                android:drawableTop="@drawable/ic_wallpaper"
                android:drawableTint="@color/ui_accent"
                android:text="壁纸" />
            <Button
                android:id="@+id/quickRestart"
                style="@style/LibreDeXQuickAction"
                android:drawableTop="@drawable/ic_restart"
                android:drawableTint="@color/ui_accent"
                android:text="重启会话" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/moonlightContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/dexContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/LibreDeXSectionTitle"
                    android:text="服务" />

                <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                    <LinearLayout style="@style/LibreDeXRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/serviceTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sunshine 服务"
                                android:textColor="@color/ui_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/serviceSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/ui_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/serviceBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_libredex_badge"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="待机"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ipText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="IP：--"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/telemetryChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout style="@style/LibreDeXChip">
                                <TextView
                                    style="@style/LibreDeXChipLabel"
                                    android:text="编码器" />
                                <TextView
                                    android:id="@+id/chipCodecValue"
                                    style="@style/LibreDeXChipValue" />
                            </LinearLayout>
                            <LinearLayout style="@style/LibreDeXChip">
                                <TextView
                                    style="@style/LibreDeXChipLabel"
                                    android:text="分辨率" />
                                <TextView
                                    android:id="@+id/chipResolutionValue"
                                    style="@style/LibreDeXChipValue" />
                            </LinearLayout>
                            <LinearLayout style="@style/LibreDeXChip">
                                <TextView
                                    style="@style/LibreDeXChipLabel"
                                    android:text="码率" />
                                <TextView
                                    android:id="@+id/chipBitrateValue"
                                    style="@style/LibreDeXChipValue" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">
                            <LinearLayout style="@style/LibreDeXChip">
                                <TextView
                                    style="@style/LibreDeXChipLabel"
                                    android:text="输入帧率" />
                                <TextView
                                    android:id="@+id/chipInputFpsValue"
                                    style="@style/LibreDeXChipValue" />
                            </LinearLayout>
                            <LinearLayout style="@style/LibreDeXChip">
                                <TextView
                                    style="@style/LibreDeXChipLabel"
                                    android:text="输出帧率" />
                                <TextView
                                    android:id="@+id/chipOutputFpsValue"
                                    style="@style/LibreDeXChipValue" />
                            </LinearLayout>
                            <LinearLayout style="@style/LibreDeXChip">
                                <TextView
                                    style="@style/LibreDeXChipLabel"
                                    android:text="Ping" />
                                <TextView
                                    android:id="@+id/chipPingValue"
                                    style="@style/LibreDeXChipValue" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/serviceActionButton"
                        style="@style/LibreDeXButtonPrimary"
                        android:layout_marginTop="14dp"
                        android:text="启动服务" />
                </LinearLayout>

                <TextView
                    style="@style/LibreDeXSectionTitle"
                    android:text="客户端" />

                <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                    <LinearLayout style="@style/LibreDeXRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="自动连接 Moonlight 客户端"
                                android:textColor="@color/ui_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="2dp"
                                android:text="启动后自动连接已选客户端"
                                android:textColor="@color/ui_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/autoConnectSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/clientSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_libredex_button_neutral"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <Button
                        android:id="@+id/manualClientButton"
                        style="@style/LibreDeXButtonSoft"
                        android:layout_marginTop="12dp"
                        android:text="手动输入 IP / 端口" />
                </LinearLayout>

                <TextView
                    style="@style/LibreDeXSectionTitle"
                    android:text="传输" />

                <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/entryEncoder"
                        style="@style/LibreDeXEntryRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="编码与传输"
                                android:textColor="@color/ui_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/entryEncoderSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="H.264 · 码率 100% · 60fps"
                                android:textColor="@color/ui_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="进入"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ui_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/entryAudio"
                        style="@style/LibreDeXEntryRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="音频与输入"
                                android:textColor="@color/ui_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="音频路由与输入兼容选项"
                                android:textColor="@color/ui_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="进入"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ui_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/entryLogs"
                        style="@style/LibreDeXEntryRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="查看日志"
                                android:textColor="@color/ui_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="会话与流媒体日志"
                                android:textColor="@color/ui_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="进入"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ui_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mirrorContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/LibreDeXSectionTitle"
                    android:text="镜像" />

                <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                    <LinearLayout style="@style/LibreDeXRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="镜像源"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/mirrorSourceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="手机主屏 Display 0"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout style="@style/LibreDeXRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="状态"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/mirrorStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未启动"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout style="@style/LibreDeXRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="输出"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/mirrorOutputText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Moonlight 客户端"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                    <Button
                        android:id="@+id/mirrorActionButton"
                        style="@style/LibreDeXButtonPrimary"
                        android:text="开始镜像" />
                    <TextView
                        android:id="@+id/mirrorHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="纯镜像需要 Shizuku 权限来采集主屏画面。"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/placeholderContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <TextView
                    android:id="@+id/placeholderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DP / HDMI 有线"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/placeholderSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="外接屏直连 DeX，后续版本支持"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="12sp" />
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="状态"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/placeholderStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="尚未连接"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/placeholderActionButton"
                    style="@style/LibreDeXButtonPrimary"
                    android:layout_marginTop="12dp"
                    android:text="开始 DP 输出" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/placeholderModeCard"
                style="@style/LibreDeXCard"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="外接屏分辨率"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/placeholderModeButton"
                    style="@style/LibreDeXButtonNeutral"
                    android:layout_marginTop="10dp"
                    android:text="读取外接屏分辨率列表" />
                <LinearLayout
                    android:id="@+id/placeholderCustomModeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="自定义模式"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/placeholderModeWidthInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:hint="宽"
                            android:inputType="number"
                            android:maxLines="1" />
                        <EditText
                            android:id="@+id/placeholderModeHeightInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:hint="高"
                            android:inputType="number"
                            android:maxLines="1" />
                        <EditText
                            android:id="@+id/placeholderModeRefreshInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:hint="刷新率"
                            android:inputType="number"
                            android:maxLines="1" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/placeholderCustomModeButton"
                        style="@style/LibreDeXButtonNeutral"
                        android:layout_marginTop="8dp"
                        android:text="应用自定义模式" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/optionalTransportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/subPageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
