<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/transportTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/transportMoonlight"
                style="@style/LibreDeXTransportTab"
                android:text="@string/brand_moonlight" />

            <Button
                android:id="@+id/transportDp"
                style="@style/LibreDeXTransportTab"
                android:text="@string/brand_dp_hdmi" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/firstUseCard"
            style="@style/LibreDeXCard"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/LibreDeXRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_first_time"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/connection_guide_desc"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/openWizardButton"
                    style="@style/LibreDeXButtonSoft"
                    android:text="@string/connection_open_guide" />

                <ImageButton
                    android:id="@+id/hideFirstUseButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/connection_hide"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connection_source"
                android:textColor="@color/ui_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/connection_source_desc"
                android:textColor="@color/ui_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/sourceSegContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_libredex_seg_container"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/sourceDexButton"
                    style="@style/LibreDeXSegButton"
                    android:text="@string/connection_dex_desktop" />
                <Button
                    android:id="@+id/sourceMirrorButton"
                    style="@style/LibreDeXSegButton"
                    android:text="@string/connection_mirror" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/quickActionsTitle"
            style="@style/LibreDeXSectionTitle"
            android:text="@string/connection_quick_actions" />

        <LinearLayout
            android:id="@+id/quickActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/quickTouchpad"
                style="@style/LibreDeXQuickAction"
                android:drawableTop="@drawable/ic_touchpad"
                android:drawableTint="@color/ui_accent"
                android:text="@string/connection_touchpad" />
            <Button
                android:id="@+id/quickScreenOff"
                style="@style/LibreDeXQuickAction"
                android:drawableTop="@drawable/ic_screen_off"
                android:drawableTint="@color/ui_accent"
                android:text="@string/connection_off_screen" />
            <Button
                android:id="@+id/quickWallpaper"
                style="@style/LibreDeXQuickAction"
                android:drawableTop="@drawable/ic_wallpaper"
                android:drawableTint="@color/ui_accent"
                android:text="@string/connection_wallpaper" />
            <Button
                android:id="@+id/quickRestart"
                style="@style/LibreDeXQuickAction"
                android:drawableTop="@drawable/ic_restart"
                android:drawableTint="@color/ui_accent"
                android:text="@string/connection_restart_session" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/moonlightContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/dexContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/LibreDeXSectionTitle"
                    android:text="@string/connection_service" />

                <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                    <LinearLayout style="@style/LibreDeXRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/serviceTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/connection_sunshine_service"
                                android:textColor="@color/ui_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/serviceSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/ui_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/serviceBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_libredex_badge"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/connection_standby"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ipText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/connection_ip_placeholder"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    

                    <Button
                        android:id="@+id/serviceActionButton"
                        style="@style/LibreDeXButtonPrimary"
                        android:layout_marginTop="14dp"
                        android:text="@string/connection_start_service" />
                </LinearLayout>

                
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mirrorContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/LibreDeXSectionTitle"
                    android:text="@string/connection_mirror_short" />

                <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                    <LinearLayout style="@style/LibreDeXRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/connection_mirror_source"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/mirrorSourceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connection_display_0"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout style="@style/LibreDeXRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/connection_status"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/mirrorStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connection_not_started"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout style="@style/LibreDeXRow">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/connection_output"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/mirrorOutputText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connection_moonlight_client"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                    <Button
                        android:id="@+id/mirrorActionButton"
                        style="@style/LibreDeXButtonPrimary"
                        android:text="@string/connection_start_service" />
                    <TextView
                        android:id="@+id/mirrorHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/connection_mirror_needs_shizuku"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        


        <LinearLayout
            android:id="@+id/sharedCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
<LinearLayout
                    android:id="@+id/telemetryChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout style="@style/LibreDeXChip">
                            <TextView
                                style="@style/LibreDeXChipLabel"
                                android:text="@string/connection_encoder" />
                            <TextView
                                android:id="@+id/chipCodecValue"
                                style="@style/LibreDeXChipValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/LibreDeXChip">
                            <TextView
                                style="@style/LibreDeXChipLabel"
                                android:text="@string/connection_resolution" />
                            <TextView
                                android:id="@+id/chipResolutionValue"
                                style="@style/LibreDeXChipValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/LibreDeXChip">
                            <TextView
                                style="@style/LibreDeXChipLabel"
                                android:text="@string/connection_bitrate" />
                            <TextView
                                android:id="@+id/chipBitrateValue"
                                style="@style/LibreDeXChipValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <LinearLayout style="@style/LibreDeXChip">
                            <TextView
                                style="@style/LibreDeXChipLabel"
                                android:text="@string/connection_input_fps" />
                            <TextView
                                android:id="@+id/chipInputFpsValue"
                                style="@style/LibreDeXChipValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/LibreDeXChip">
                            <TextView
                                style="@style/LibreDeXChipLabel"
                                android:text="@string/connection_output_fps" />
                            <TextView
                                android:id="@+id/chipOutputFpsValue"
                                style="@style/LibreDeXChipValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/LibreDeXChip">
                            <TextView
                                style="@style/LibreDeXChipLabel"
                                android:text="@string/connection_ping" />
                            <TextView
                                android:id="@+id/chipPingValue"
                                style="@style/LibreDeXChipValue" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
<TextView
                style="@style/LibreDeXSectionTitle"
                android:text="@string/connection_client" />

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <LinearLayout style="@style/LibreDeXRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/connection_auto_connect_client"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/connection_auto_connect_desc"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/autoConnectSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/clientSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_libredex_button_neutral"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <Button
                    android:id="@+id/manualClientButton"
                    style="@style/LibreDeXButtonSoft"
                    android:layout_marginTop="12dp"
                    android:text="@string/connection_manual_input" />
            </LinearLayout>

            <TextView
                style="@style/LibreDeXSectionTitle"
                android:text="@string/connection_transport" />

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/entryEncoder"
                    style="@style/LibreDeXEntryRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/connection_encode_transport"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/entryEncoderSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/connection_h264_100_60"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/action_enter"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ui_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/entryAudio"
                    style="@style/LibreDeXEntryRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/audio_title"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/connection_audio_options"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/action_enter"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ui_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/entryLogs"
                    style="@style/LibreDeXEntryRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/connection_view_log"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/connection_session_log"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/action_enter"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ui_text_secondary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
<LinearLayout
            android:id="@+id/placeholderContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <TextView
                    android:id="@+id/placeholderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connection_dp_hdmi_wired"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/placeholderSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/connection_dex_external_note"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="12sp" />
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/connection_status"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/placeholderStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_not_connected"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/placeholderActionButton"
                    style="@style/LibreDeXButtonPrimary"
                    android:layout_marginTop="12dp"
                    android:text="@string/connection_start_dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/placeholderModeCard"
                style="@style/LibreDeXCard"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connection_external_resolution"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/placeholderModeButton"
                    style="@style/LibreDeXButtonNeutral"
                    android:layout_marginTop="10dp"
                    android:text="@string/connection_read_external_modes" />
                <LinearLayout
                    android:id="@+id/placeholderCustomModeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/connection_custom_mode"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/placeholderModeWidthInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:hint="@string/connection_width"
                            android:inputType="number"
                            android:maxLines="1" />
                        <EditText
                            android:id="@+id/placeholderModeHeightInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:hint="@string/connection_height"
                            android:inputType="number"
                            android:maxLines="1" />
                        <EditText
                            android:id="@+id/placeholderModeRefreshInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:hint="@string/connection_refresh_rate"
                            android:inputType="number"
                            android:maxLines="1" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/placeholderCustomModeButton"
                        style="@style/LibreDeXButtonNeutral"
                        android:layout_marginTop="8dp"
                        android:text="@string/connection_apply_custom_mode" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/optionalTransportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/subPageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
