<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_page_padding"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/ui_page_padding"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/guideButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/ui_home_button_height"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_small_button"
                android:elevation="@dimen/ui_shadow_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/home_guide"
                android:textColor="@color/ui_text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/darkModeButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/ui_home_button_height"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_small_button"
                android:elevation="@dimen/ui_shadow_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/settings_dark_theme"
                android:textColor="@color/ui_text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/screenOffButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/ui_home_button_height"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_small_button"
                android:elevation="@dimen/ui_shadow_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/connection_off_screen"
                android:textColor="@color/ui_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/serviceButton"
            android:layout_width="@dimen/ui_service_button_size"
            android:layout_height="@dimen/ui_service_button_size"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_ui_service_button_stopped"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:foreground="@drawable/bg_ui_service_button_ring">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/serviceStatusPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/connection_start_service"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/serviceStatusSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/home_sunshine_stopped"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/ipAddressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/connection_ip_placeholder"
            android:textColor="@color/ui_text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/simpleDebugPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_ui_panel"
            android:clickable="true"
            android:elevation="@dimen/ui_shadow_small"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_encoder"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/debugCodecValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_resolution"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/debugResolutionValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_bitrate"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/debugBitrateValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_input_fps"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/debugInputFpsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_output_fps"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/debugOutputFpsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_ping"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/debugPingValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
