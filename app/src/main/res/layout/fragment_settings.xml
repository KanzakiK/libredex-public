<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView style="@style/LibreDeXSectionTitle" android:text="@string/settings_permission_section" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout style="@style/LibreDeXRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_shizuku"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/shizukuStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_not_granted"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/shizukuGrantButton"
                    style="@style/LibreDeXButtonSoft"
                    android:text="@string/action_grant" />
            </LinearLayout>
            <TextView
                android:id="@+id/rootShizukuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_root_status"
                android:textColor="@color/ui_text_secondary"
                android:textSize="12sp" />
            <Button
                android:id="@+id/rootShizukuButton"
                style="@style/LibreDeXButtonSoft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_root_restart_shizuku" />
            <LinearLayout style="@style/LibreDeXRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_overlay_permission"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/overlayStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_not_granted"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_file_permission"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/storageStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_file_not_granted"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_userservice"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/userServiceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_not_running"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/restartUserServiceButton"
                    style="@style/LibreDeXButtonSoft"
                    android:text="@string/action_restart" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/LibreDeXSectionTitle" android:text="@string/settings_appearance" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme"
                android:textColor="@color/ui_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_libredex_seg_container"
                android:orientation="horizontal"
                android:padding="4dp">
                <Button
                    android:id="@+id/themeSystemButton"
                    style="@style/LibreDeXSegButton"
                    android:text="@string/settings_follow_system" />
                <Button
                    android:id="@+id/themeLightButton"
                    style="@style/LibreDeXSegButton"
                    android:text="@string/settings_light_theme" />
                <Button
                    android:id="@+id/themeDarkButton"
                    style="@style/LibreDeXSegButton"
                    android:layout_marginEnd="0dp"
                    android:text="@string/settings_dark_theme" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_language"
                android:textColor="@color/ui_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_libredex_seg_container"
                android:orientation="horizontal"
                android:padding="4dp">
                <Button
                    android:id="@+id/languageSystemButton"
                    style="@style/LibreDeXSegButton"
                    android:text="@string/settings_language_follow_system" />
                <Button
                    android:id="@+id/languageZhButton"
                    style="@style/LibreDeXSegButton"
                    android:text="@string/settings_language_zh" />
                <Button
                    android:id="@+id/languageEnButton"
                    style="@style/LibreDeXSegButton"
                    android:layout_marginEnd="0dp"
                    android:text="@string/settings_language_en" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/LibreDeXSectionTitle" android:text="@string/action_get_started" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout
                android:id="@+id/wizardEntry"
                style="@style/LibreDeXEntryRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_init_guide"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_guide_desc"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/action_enter"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/LibreDeXSectionTitle" android:text="@string/settings_debug" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout
                android:id="@+id/logsEntry"
                style="@style/LibreDeXEntryRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/connection_view_log"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/action_enter"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/exportLogsEntry"
                style="@style/LibreDeXEntryRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_export_log"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/action_enter"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/LibreDeXSectionTitle" android:text="@string/action_about" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout
                android:id="@+id/aboutEntry"
                style="@style/LibreDeXEntryRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_about_libredex"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/action_enter"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
