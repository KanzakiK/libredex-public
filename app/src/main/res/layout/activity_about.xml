<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_top_bar_height"
        android:background="@color/ui_surface"
        android:elevation="@dimen/ui_top_bar_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/aboutBackButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="返回"
            android:textColor="@color/ui_text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="关于"
            android:textColor="@color/ui_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="64dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_page_padding"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/ui_page_padding"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/aboutAppIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="LibreDeX"
                android:src="@mipmap/ic_launcher_v2" />

            <TextView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="LibreDeX"
                android:textColor="@color/ui_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="版本："
                android:textColor="@color/ui_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_ui_panel"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/aboutContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/githubButton"
                style="@style/LibreDeXLargeButton"
                android:layout_marginTop="@dimen/ui_section_gap"
                android:text="GitHub 项目地址" />

            <Button
                android:id="@+id/releasesButton"
                style="@style/LibreDeXLargeButton"
                android:layout_marginTop="@dimen/ui_row_gap"
                android:text="下载最新版本" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
