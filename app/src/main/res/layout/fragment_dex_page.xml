<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_page_padding"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/ui_page_padding"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DeX 会话"
                android:textColor="@color/ui_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dexServiceStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ui_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dexSessionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ui_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dexDisplayIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ui_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ui_panel"
            android:elevation="@dimen/ui_shadow_small"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/dexLayerFixSwitch"
                style="@style/LibreDeXSettingSwitch"
                android:text="窗口/层级修复" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ui_row_side_padding"
                android:paddingEnd="@dimen/ui_row_side_padding"
                android:paddingBottom="10dp"
                android:text="控制 persist.dex.lspmirror.mode，需 Shizuku/root 生效。"
                android:textColor="@color/ui_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dexRestartSessionButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_small_button"
                android:elevation="@dimen/ui_shadow_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="重启会话"
                android:textColor="@color/ui_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/dexReleaseSessionButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_small_button"
                android:elevation="@dimen/ui_shadow_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="释放会话"
                android:textColor="@color/ui_text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
