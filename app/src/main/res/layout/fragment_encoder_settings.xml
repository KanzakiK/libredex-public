<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/encoderBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="@color/ui_text_primary" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="编码与传输"
                android:textColor="@color/ui_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="编码格式" />
                <Spinner
                    android:id="@+id/encoderCodecSpinner"
                    style="@style/LibreDeXFieldInput" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="码率比例" />
                <EditText
                    android:id="@+id/encoderBitrateEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="25-200"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="码率模式" />
                <Spinner
                    android:id="@+id/encoderBitrateModeSpinner"
                    style="@style/LibreDeXFieldInput" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="复杂度" />
                <EditText
                    android:id="@+id/encoderComplexityEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="0-10"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="I 帧间隔" />
                <EditText
                    android:id="@+id/encoderIFrameEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="1-10"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="最大 FPS" />
                <EditText
                    android:id="@+id/encoderMaxFpsEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="1-240"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="FEC" />
                <EditText
                    android:id="@+id/encoderFecEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="0-50"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/LibreDeXSectionTitle"
            android:text="开关" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout style="@style/LibreDeXRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="低延迟编码"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/encoderLowLatencySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="禁用 B 帧"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/encoderDisableBSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="实时优先级"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/encoderRealtimeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="动态帧率"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/encoderDynamicSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/LibreDeXSectionTitle"
            android:text="诊断" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout
                android:id="@+id/encoderHandshakeEntry"
                style="@style/LibreDeXEntryRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最近握手信息"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="进入"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/encoderControlEntry"
                style="@style/LibreDeXEntryRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最近控制输入统计"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="进入"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <Button
                android:id="@+id/encoderSaveButton"
                style="@style/LibreDeXButtonPrimary"
                android:text="保存" />
            <Button
                android:id="@+id/encoderResetButton"
                style="@style/LibreDeXButtonNeutral"
                android:layout_marginTop="8dp"
                android:text="恢复默认" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
