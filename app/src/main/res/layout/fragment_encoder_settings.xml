<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/encoderBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="@color/ui_text_primary" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/connection_encode_transport"
                android:textColor="@color/ui_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="@string/encoder_format" />
                <Spinner
                    android:id="@+id/encoderCodecSpinner"
                    style="@style/LibreDeXFieldInput" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="@string/encoder_bitrate_ratio" />
                <EditText
                    android:id="@+id/encoderBitrateEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="@string/encoder_range_25_200"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="@string/encoder_bitrate_mode" />
                <Spinner
                    android:id="@+id/encoderBitrateModeSpinner"
                    style="@style/LibreDeXFieldInput" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="@string/encoder_complexity" />
                <EditText
                    android:id="@+id/encoderComplexityEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="@string/encoder_range_0_10"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="@string/encoder_i_frame_interval" />
                <EditText
                    android:id="@+id/encoderIFrameEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="@string/encoder_range_1_10"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="@string/encoder_max_fps" />
                <EditText
                    android:id="@+id/encoderMaxFpsEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="@string/encoder_range_1_240"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXFieldRow">
                <TextView style="@style/LibreDeXFieldLabel" android:text="@string/encoder_fec" />
                <EditText
                    android:id="@+id/encoderFecEdit"
                    style="@style/LibreDeXFieldInput"
                    android:hint="@string/encoder_range_0_50"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/LibreDeXSectionTitle"
            android:text="@string/encoder_toggle" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout style="@style/LibreDeXRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/encoder_low_latency"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/encoderLowLatencySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/encoder_disable_b_frame"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/encoderDisableBSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/encoder_realtime_priority"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/encoderRealtimeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout style="@style/LibreDeXRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/encoder_dynamic_fps"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/encoderDynamicSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/LibreDeXSectionTitle"
            android:text="@string/encoder_diagnostics" />

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <LinearLayout
                android:id="@+id/encoderHandshakeEntry"
                style="@style/LibreDeXEntryRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/encoder_recent_handshake"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/action_enter"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/encoderControlEntry"
                style="@style/LibreDeXEntryRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/encoder_recent_input_stats"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/action_enter"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
            <Button
                android:id="@+id/encoderSaveButton"
                style="@style/LibreDeXButtonPrimary"
                android:text="@string/action_save" />
            <Button
                android:id="@+id/encoderResetButton"
                style="@style/LibreDeXButtonNeutral"
                android:layout_marginTop="8dp"
                android:text="@string/action_restore_default" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
