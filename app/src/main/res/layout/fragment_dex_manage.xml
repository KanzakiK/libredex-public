<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/mirrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_libredex_banner"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dex_mirror_mode_note"
                android:textColor="@color/ui_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/dex_mirror_hide_note"
                android:textColor="@color/ui_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dexContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/LibreDeXSectionTitle" android:text="@string/dex_session" />

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_session"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/dexSessionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_libredex_badge"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/connection_standby"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="@string/brand_display"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/dexDisplayValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brand_secondary_launcher"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/dexLauncherValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dex_pending_start"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_window_fix"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexLayerFixSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/LibreDeXSectionTitle" android:text="@string/dex_touchpad" />

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <LinearLayout style="@style/LibreDeXRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dex_touchpad"
                            android:textColor="@color/ui_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dex_open_system_touchpad"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/dexTouchpadButton"
                        style="@style/LibreDeXButtonSoft"
                        android:text="@string/action_open" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/LibreDeXSectionTitle" android:text="@string/dex_session_actions" />

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <Button
                    android:id="@+id/dexRestartButton"
                    style="@style/LibreDeXButtonNeutral"
                    android:text="@string/connection_restart_session" />
                <Button
                    android:id="@+id/dexReleaseButton"
                    style="@style/LibreDeXButtonDanger"
                    android:layout_marginTop="8dp"
                    android:text="@string/dex_release_session" />
            </LinearLayout>

            <TextView style="@style/LibreDeXSectionTitle" android:text="@string/connection_wallpaper" />

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <ImageView
                    android:id="@+id/wallpaperPreview"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_wallpaper_preview"
                    android:scaleType="centerCrop" />
                <Button
                    android:id="@+id/dexChangeWallpaperButton"
                    style="@style/LibreDeXButtonSoft"
                    android:layout_marginTop="12dp"
                    android:text="@string/dex_change_wallpaper" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/commonContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/LibreDeXSectionTitle" android:text="@string/dex_display_section" />

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_auto_rotate"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexAutoRotateSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_auto_scale"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexAutoScaleSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_auto_aspect"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexAutoMatchSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/LibreDeXSectionTitle" android:text="@string/dex_screen_manage" />

            <LinearLayout style="@style/LibreDeXCard" android:orientation="vertical">
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_auto_off"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexAutoScreenOffSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_black_image_off"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexBlackImageSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_block_auto_lock"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexPreventLockSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_fake_off"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexFakeScreenSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/LibreDeXRow">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dex_block_sleep"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dexPreventSleepSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <Button
                    android:id="@+id/dexManualScreenOffButton"
                    style="@style/LibreDeXButtonSoft"
                    android:layout_marginTop="8dp"
                    android:text="@string/dex_manual_off" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mirrorActionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/dexStopMirrorButton"
                style="@style/LibreDeXButtonDanger"
                android:text="@string/dex_stop_mirror" />
        </LinearLayout>

        <TextView
            android:id="@+id/dexExperimentalTitle"
            style="@style/LibreDeXSectionTitle"
            android:text="@string/dex_experimental" />

        <LinearLayout
            android:id="@+id/dexExperimentalCard"
            style="@style/LibreDeXCard"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/dexScreenSettingsEntry"
                style="@style/LibreDeXEntryRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dex_screen_settings_exp"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/dex_screen_settings_entry"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/action_enter"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
