<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_top_bar_height"
        android:background="@color/ui_surface"
        android:elevation="@dimen/ui_top_bar_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/screenSettingsBackButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/action_back"
            android:textColor="@color/ui_text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/screen_title"
            android:textColor="@color/ui_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="64dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_page_padding"
            android:paddingTop="@dimen/ui_section_gap"
            android:paddingEnd="@dimen/ui_page_padding"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/screenSettingsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/screenSettingsWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/screen_experimental_warning"
                    android:textColor="@color/ui_warning"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <Button
                        android:id="@+id/requestShizukuButton"
                        android:layout_width="@dimen/ui_small_button_width"
                        android:layout_height="@dimen/ui_small_button_height"
                        android:background="@drawable/bg_ui_small_button"
                        android:elevation="@dimen/ui_shadow_small"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="@string/action_grant"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/openCastSettingsButton"
                        android:layout_width="@dimen/ui_small_button_width"
                        android:layout_height="@dimen/ui_small_button_height"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ui_small_button"
                        android:elevation="@dimen/ui_shadow_small"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="@string/common_projection"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/refreshDisplaysButton"
                        android:layout_width="@dimen/ui_small_button_width"
                        android:layout_height="@dimen/ui_small_button_height"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ui_small_button"
                        android:elevation="@dimen/ui_shadow_small"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="@string/action_refresh"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/displayListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_section_gap"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
